#Use Autoencoder to implement anomaly detection
# a. Import required libraries
import numpy as np
import matplotlib.pyplot as plt
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Dense
from sklearn.preprocessing import MinMaxScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, confusion_matrix
from sklearn.datasets import load_breast_cancer
 
# b. Upload / access the dataset (Breast Cancer: malignant treated as anomaly)
data = load_breast_cancer()
X = data.data
y = (data.target == 0).astype(int)        # 1 = anomaly (malignant), 0 = normal (benign)
X = MinMaxScaler().fit_transform(X)
X_normal = X[y == 0]
X_train, X_val = train_test_split(X_normal, test_size=0.2, random_state=42)
print("Normal samples:", len(X_normal), " Anomalies:", (y == 1).sum())
 
# c. Encoder converts it into latent representation
input_dim = X.shape[1]
inp = Input(shape=(input_dim,))
enc = Dense(16, activation="relu")(inp)
enc = Dense(8, activation="relu")(enc)
latent = Dense(4, activation="relu")(enc)
 
# d. Decoder converts it back to the original input
dec = Dense(8, activation="relu")(latent)
dec = Dense(16, activation="relu")(dec)
out = Dense(input_dim, activation="sigmoid")(dec)
 
# e. Compile with Optimizer, Loss and Evaluation Metrics
autoencoder = Model(inp, out)
autoencoder.compile(optimizer="adam", loss="mse", metrics=["mae"])
autoencoder.summary()
hist = autoencoder.fit(X_train, X_train, epochs=50, batch_size=16,
                       validation_data=(X_val, X_val), verbose=0)
for e in range(0, 50, 10):
    print(f"Epoch {e+1:3d}  loss: {hist.history['loss'][e]:.5f}  val_loss: {hist.history['val_loss'][e]:.5f}")
print("Final train loss:", hist.history["loss"][-1])
 
# Anomaly detection using reconstruction error
recon = autoencoder.predict(X, verbose=0)
mse = np.mean(np.power(X - recon, 2), axis=1)
threshold = np.percentile(mse[y == 0], 95)
y_pred = (mse > threshold).astype(int)
print("Threshold:", threshold)
print(confusion_matrix(y, y_pred))
print(classification_report(y, y_pred, target_names=["Normal", "Anomaly"]))
 
plt.plot(hist.history["loss"], label="train"); plt.plot(hist.history["val_loss"], label="val")
plt.title("Autoencoder Loss - sohamwani"); plt.legend()
plt.show()
plt.hist(mse[y == 0], bins=30, alpha=.6, label="Normal")
plt.hist(mse[y == 1], bins=30, alpha=.6, label="Anomaly")
plt.axvline(threshold, color="k", ls="--"); plt.legend()
plt.title("Reconstruction Error - sohamwani")
plt.show()
