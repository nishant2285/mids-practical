#Object detection using Transfer Learning of CNN architectures
import os
import ssl
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras.applications import MobileNetV2
from tensorflow.keras import layers, models, optimizers
 
ssl._create_default_https_context = ssl._create_unverified_context
 
# Dataset: TensorFlow Flowers (5 classes, downloaded automatically, needs internet the first time)
import shutil
url = "https://storage.googleapis.com/download.tensorflow.org/example_images/flower_photos.tgz"
cache = os.path.join(os.path.expanduser("~"), ".keras", "datasets")
 
def get_flowers():
    for attempt in range(1, 4):
        try:
            path = tf.keras.utils.get_file("flower_photos.tgz", origin=url, extract=True)
            for d in [os.path.join(os.path.dirname(path), "flower_photos"), path,
                      os.path.join(path, "flower_photos")]:
                if os.path.isdir(os.path.join(d, "daisy")):
                    return d
            raise RuntimeError("flower_photos folder not found after extraction")
        except Exception as e:            # incomplete download -> delete cache and retry
            print(f"Download/extract attempt {attempt} failed ({type(e).__name__}); cleaning cache and retrying")
            shutil.rmtree(os.path.join(cache, "flower_photos"), ignore_errors=True)
            if os.path.exists(os.path.join(cache, "flower_photos.tgz")):
                os.remove(os.path.join(cache, "flower_photos.tgz"))
    raise SystemExit("Could not download the flowers dataset - check your internet connection.")
 
data_dir = get_flowers()
IMG = (160, 160)
train_ds = tf.keras.utils.image_dataset_from_directory(data_dir, validation_split=0.2, subset="training",
                                                       seed=123, image_size=IMG, batch_size=32)
val_ds = tf.keras.utils.image_dataset_from_directory(data_dir, validation_split=0.2, subset="validation",
                                                     seed=123, image_size=IMG, batch_size=32)
class_names = train_ds.class_names
print("Classes:", class_names)
AUTOTUNE = tf.data.AUTOTUNE
train_ds = train_ds.prefetch(AUTOTUNE); val_ds = val_ds.prefetch(AUTOTUNE)
 
# a. Load a pre-trained CNN model trained on a large dataset (ImageNet)
base_model = MobileNetV2(input_shape=IMG + (3,), include_top=False, weights="imagenet")
 
# b. Freeze parameters (weights) in lower convolutional layers
base_model.trainable = False
print("Layers in base model:", len(base_model.layers))
 
# c. Add custom classifier with several trainable layers
model = models.Sequential([
    layers.Input(shape=IMG + (3,)),
    layers.Rescaling(1./127.5, offset=-1),
    base_model,
    layers.GlobalAveragePooling2D(),
    layers.Dense(128, activation="relu"),
    layers.Dropout(0.3),
    layers.Dense(len(class_names), activation="softmax")
])
model.compile(optimizer=optimizers.Adam(1e-3), loss="sparse_categorical_crossentropy", metrics=["accuracy"])
model.summary()
 
# d. Train classifier layers on available training data
h1 = model.fit(train_ds, validation_data=val_ds, epochs=3, verbose=2)
 
# e. Fine-tune hyper-parameters and unfreeze more layers
base_model.trainable = True
for layer in base_model.layers[:100]:
    layer.trainable = False
model.compile(optimizer=optimizers.Adam(1e-5), loss="sparse_categorical_crossentropy", metrics=["accuracy"])
h2 = model.fit(train_ds, validation_data=val_ds, epochs=3, verbose=2)
 
loss, acc = model.evaluate(val_ds, verbose=0)
print(f"Final validation accuracy after fine-tuning: {acc:.4f}")
 
acc_all = h1.history["accuracy"] + h2.history["accuracy"]
val_all = h1.history["val_accuracy"] + h2.history["val_accuracy"]
plt.plot(acc_all, label="train"); plt.plot(val_all, label="val")
plt.axvline(2.5, ls="--", color="k", label="fine-tune start")
plt.title("Transfer Learning (Flowers) - sohamwani"); plt.legend()
plt.show()
